# ---- Vehicle catalogue ------------------------------------------------------
# Comma separated list of vehicle types that can be BOOKED / registered.
# All types (bike, auto, mini, sedan, suv) are always listed in the app for
# selection, but those not enabled here show as "Coming soon".
# Future: ENABLED_VEHICLE_TYPES=bike,auto,mini,sedan,suv
ENABLED_VEHICLE_TYPES=bike

# ---- Security ---------------------------------------------------------------
JWT_SECRET=change-me-in-production
DEV_MODE=true
DEV_OTP=123456

# ---- Dispatch ---------------------------------------------------------------
OFFER_TIMEOUT_SECONDS=15
SEARCH_RADII_METERS=2000,4000,6000
MATCHING_TIMEOUT_SECONDS=75

# ---- Pricing / wallet -------------------------------------------------------
SURGE_ENABLED=true
PLATFORM_COMMISSION_PERCENT=20
SIGNUP_BONUS_PAISE=50000

# ---- Maps (free OSM services; falls back to straight-line when unreachable) --
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org

# ---- Providers: mock | real -------------------------------------------------
SMS_PROVIDER=mock
PAYMENT_PROVIDER=mock
PUSH_PROVIDER=expo
